{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Backend: Debug (npm dev)",
      "cwd": "${workspaceFolder}/apps/backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--inspect=9229"],
      "port": 9229,
      "envFile": "${workspaceFolder}/apps/backend/.env",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "type": "node",
      "request": "attach",
      "name": "Backend: Attach (port 9229)",
      "port": 9229,
      "restart": true,
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
