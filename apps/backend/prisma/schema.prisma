generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AlarmMode {
  STRICT
  LIGHT
}

enum AlarmEventType {
  SET
  SNOOZE
  DISMISS
  MORNING_PLAN_CONFIRMED
  WAKE_UNLOCK
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskSource {
  OMNI
  NOTION
  ASANA
  CALENDAR
}

enum AppCategory {
  SOCIAL
  PRODUCTIVITY
  ENTERTAINMENT
  OTHER
}

enum IntegrationProvider {
  GOOGLE_CALENDAR
  NOTION
  ASANA
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  passwordHash String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  alarmSettings          AlarmSetting[]
  tasks                  Task[]
  focusBlocks            FocusBlock[]
  screenTimeEvents       ScreenTimeEvent[]
  dailyReflections       DailyReflection[]
  integrationConnections IntegrationConnection[]
  dayPlanConfirmations   DayPlanConfirmation[]
}

model AlarmSetting {
  id          String    @id @default(uuid())
  userId      String
  wakeTime    DateTime
  mode        AlarmMode
  nextAlarmAt DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs AlarmLog[]

  @@index([userId])
  @@unique([userId])
}

model Task {
  id             String      @id @default(uuid())
  userId         String
  title          String
  description    String?
  status         TaskStatus  @default(TODO)
  source         TaskSource  @default(OMNI)
  scheduledStart DateTime?
  scheduledEnd   DateTime?
  actualStart    DateTime?
  actualEnd      DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  focusBlocks FocusBlock[]
  dayPlanTasks DayPlanTask[]

  @@index([userId])
  @@index([userId, status])
  @@index([userId, scheduledStart])
}

model FocusBlock {
  id           String   @id @default(uuid())
  userId       String
  taskId       String?
  plannedStart DateTime
  plannedEnd   DateTime
  actualStart  DateTime?
  actualEnd    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([taskId])
  @@index([userId, plannedStart])
}

model ScreenTimeEvent {
  id         String      @id @default(uuid())
  userId     String
  appName    String
  appCategory AppCategory
  startedAt  DateTime
  endedAt    DateTime
  createdAt  DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, startedAt])
}

model DailyReflection {
  id         String    @id @default(uuid())
  userId     String
  date       DateTime  @db.Date
  rating     Int
  notes      String    @db.Text
  aiSummary  String?   @db.Text
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
}

model IntegrationConnection {
  id           String               @id @default(uuid())
  userId       String
  provider     IntegrationProvider
  accessToken  String
  refreshToken String
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
}

model AlarmLog {
  id        String          @id @default(uuid())
  userId    String
  alarmId   String?
  type      AlarmEventType
  timestamp DateTime        @default(now())
  metadata  Json?

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  alarm AlarmSetting? @relation(fields: [alarmId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([alarmId])
}

model DayPlan {
  id               String        @id @default(uuid())
  userId           String
  date             DateTime      @db.Date
  confirmedAt      DateTime?
  wakeConfirmedAt  DateTime?
  compressed       Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks      DayPlanTask[]

  @@unique([userId, date])
  @@index([userId, date])
}

model DayPlanTask {
  id           String    @id @default(uuid())
  dayPlanId    String
  taskId       String
  isTopTask    Boolean   @default(false)
  order        Int       @default(0)
  plannedStart DateTime?
  plannedEnd   DateTime?

  dayPlan DayPlan @relation(fields: [dayPlanId], references: [id], onDelete: Cascade)
  task    Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([dayPlanId])
  @@index([taskId])
  @@index([dayPlanId, order])
}

model DayPlanConfirmation {
  id          String   @id @default(uuid())
  userId      String
  date        DateTime @db.Date
  confirmedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
}
